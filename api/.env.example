# EnlaceSeguro API Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# HTTP loopback is allowed only for local development/tests; production requires explicit HTTPS.
SANDBOX_SERVICE_URL=http://localhost:3001
# Generate once and set the same random value in API and Sandbox (e.g. openssl rand -base64 32)
SANDBOX_SERVICE_TOKEN=replace-me
SANDBOX_ANALYSIS_TIMEOUT_MS=30000
# Disabled until private API-to-Sandbox connectivity and controls are verified.
CAPTURE_PROXY_ENABLED=false
ANALYSIS_JOB_CONCURRENCY=2
ANALYSIS_JOB_POLL_INTERVAL_MS=1000
ANALYSIS_JOB_LEASE_MS=180000
ANALYSIS_JOB_SHUTDOWN_GRACE_MS=40000
ANALYSIS_JOB_MAX_ATTEMPTS=4
ANALYSIS_JOB_SNAPSHOT_INTERVAL_MS=60000
# Local/test convenience only. Set and size explicitly for staging/production.
ANALYSIS_JOB_MAX_PENDING=1000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=enlaceseguro_dev
# Required after explicitly applying database/migrations/002_create_login_rate_limit_buckets.js
LOGIN_RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-bytes-no-whitespace
# Required after explicitly applying database/migrations/003_encrypt_analysis_inputs.js.
# Generate 32 random bytes once, base64url-encode them, and keep the same key across API replicas/backups.
ANALYSIS_INPUT_ENCRYPTION_KEY=replace-with-canonical-base64url-32-byte-key
# Comma-separated exact CIDRs of trusted load balancers; leave empty for direct clients.
TRUST_PROXY_CIDRS=
# Exact HTTPS origins for a separate web admin console; empty disables browser cross-origin access.
# Local HTTP loopback is permitted only outside production. Never use * or null.
CORS_ALLOWED_ORIGINS=

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security!
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Domain Policies
TIMEZONE=America/Mexico_City
DAILY_ANALYSIS_QUOTA=5
