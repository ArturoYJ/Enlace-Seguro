{
  "name": "enlaceseguro-api",
  "version": "1.0.0",
  "description": "EnlaceSeguro REST API backend - Node.js 22 LTS, Fastify, TypeScript and MongoDB 8.0.x",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed:admin": "tsx src/infrastructure/cli/seed-admin.ts",
    "test": "node --test --import tsx 'tests/**/*.test.ts'",
    "test:integration": "node -e \"if (!process.env.MONGO_TEST_URI) { console.error('MONGO_TEST_URI must point to a disposable enlaceseguro_test_* database'); process.exit(2); }\" && node --test --import tsx 'tests/integration/**/*.test.ts'",
    "e2e:server": "node --import tsx tests/e2e/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "fastify",
    "mongodb",
    "typescript",
    "url-analyzer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "mongodb": "^6.14.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
