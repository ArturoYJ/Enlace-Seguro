#!/usr/bin/env node
// Create local-only configuration once; existing secrets and user files are never overwritten.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const net = require('node:net');
const os = require('node:os');
const { execFileSync } = require('node:child_process');
const root = path.resolve(__dirname, '../..');
const targets = ['api/.env.local', 'sandbox/.env.local', 'frontend/mobile/.env.local', 'frontend/admin-console/.env.local'];
const existing = targets.filter(file => fs.existsSync(path.join(root, file)));
if (existing.length) {
  console.error(`Refusing to overwrite existing local configuration: ${existing.join(', ')}`);
  process.exit(1);
}
// IPv4 privada de la red local. En macOS se usa la interfaz Wi-Fi en0; en Windows y Linux se
// revisan las interfaces y se descartan las virtuales (Docker, WSL, Hyper-V, VPN), que el teléfono no ve.
function detectLanIp() {
  if (process.platform === 'darwin') {
    try { return execFileSync('ipconfig', ['getifaddr', 'en0'], { encoding: 'utf8' }).trim(); } catch { return null; }
  }
  const virtual = /vethernet|wsl|docker|hyper-v|virtualbox|vmware|vbox|loopback|tailscale|zerotier|vpn|br-|veth/i;
  const isPrivate = (a) => /^10\./.test(a) || /^192\.168\./.test(a) || /^172\.(1[6-9]|2\d|3[01])\./.test(a);
  const candidates = [];
  for (const [name, addresses] of Object.entries(os.networkInterfaces())) {
    if (virtual.test(name)) continue;
    for (const a of addresses ?? []) {
      if (a.family === 'IPv4' && !a.internal && isPrivate(a.address)) candidates.push(`${a.address} (${name})`);
    }
  }
  if (candidates.length === 1) return candidates[0].split(' ')[0];
  // Con varias, se prefiere la tarjeta inalámbrica: el teléfono se conecta por Wi-Fi.
  const wifi = candidates.filter((c) => /\((wi-?fi|wlan|wireless|wl)/i.test(c));
  if (wifi.length === 1) return wifi[0].split(' ')[0];
  if (candidates.length > 1) console.error(`Several network addresses found: ${candidates.join(', ')}.`);
  return null;
}
let ip = process.argv[2] || detectLanIp();
if (!ip) {
  console.error('Cannot determine the Wi-Fi address. Supply the computer LAN IPv4 address as an argument, e.g. scripts/local/configure 192.168.1.50');
  process.exit(1);
}
if (net.isIP(ip) !== 4 || ip.startsWith('127.') || ip === '0.0.0.0') {
  console.error('Provide a non-loopback IPv4 address for the local network.'); process.exit(1);
}
const secret = () => crypto.randomBytes(32).toString('base64url');
const shared = secret();
const replace = (content, key, value) => {
  const pattern = new RegExp(`^${key}=.*$`, 'm');
  if (!pattern.test(content)) throw new Error(`Missing ${key} in example configuration`);
  return content.replace(pattern, `${key}=${value}`);
};
let api = fs.readFileSync(path.join(root, 'api/.env.example'), 'utf8');
for (const [key, value] of Object.entries({
  SANDBOX_SERVICE_TOKEN: shared, JWT_SECRET: secret(), LOGIN_RATE_LIMIT_HMAC_KEY: secret(),
  ANALYSIS_INPUT_ENCRYPTION_KEY: secret(), ANALYSIS_JOB_MAX_PENDING: '20',
  MONGODB_URI: 'mongodb://127.0.0.1:27017/?replicaSet=rs0',
  CORS_ALLOWED_ORIGINS: 'http://localhost:5173',
  // En local la API y el Sandbox comparten 127.0.0.1, así que el proxy de capturas no sale a ninguna red.
  CAPTURE_PROXY_ENABLED: 'true',
})) api = replace(api, key, value);
let sandbox = fs.readFileSync(path.join(root, 'sandbox/.env.example'), 'utf8');
sandbox = replace(replace(sandbox, 'SANDBOX_SERVICE_TOKEN', shared), 'HOST', '127.0.0.1');
// Solo para la demo local: el Sandbox llena los formularios de login con credenciales falsas.
sandbox = replace(sandbox, 'SANDBOX_CREDENTIAL_PROBE_ENABLED', 'true');
// El ejemplo trae la ruta de Chrome en macOS. En otros sistemas se busca Chrome instalado; si no
// aparece, se deja vacío y el Sandbox usa el Chromium de Playwright (npx playwright install chromium).
if (process.platform !== 'darwin') {
  const chromeCandidates = process.platform === 'win32'
    ? [process.env.PROGRAMFILES, process.env['PROGRAMFILES(X86)'], process.env.LOCALAPPDATA]
        .filter(Boolean).map((base) => path.join(base, 'Google', 'Chrome', 'Application', 'chrome.exe'))
    : ['/usr/bin/google-chrome', '/usr/bin/google-chrome-stable', '/usr/bin/chromium', '/usr/bin/chromium-browser'];
  const chrome = chromeCandidates.find((file) => fs.existsSync(file));
  sandbox = replace(sandbox, 'CHROME_EXECUTABLE_PATH', chrome ? chrome.split(path.sep).join('/') : '');
  if (!chrome) console.log('Google Chrome not found: run "cd sandbox && npx playwright install chromium" before starting the Sandbox.');
}
const files = [api, sandbox, `EXPO_PUBLIC_API_URL=http://${ip}:3000/api/v1\n`, 'VITE_API_BASE_URL=http://localhost:3000/api/v1\n'];
for (let i = 0; i < targets.length; i++) fs.writeFileSync(path.join(root, targets[i]), files[i], { flag: 'wx', mode: 0o600 });
console.log(`Local configuration created. Mobile API: http://${ip}:3000/api/v1`);
