#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compose=(docker compose -f "$root/infra/local/docker-compose.yml")
"${compose[@]}" up -d --wait mongo
"${compose[@]}" exec -T mongo mongosh --quiet --eval '
  try {
    const status = rs.status();
    if (status.set !== "rs0") throw new Error("Unexpected replica set: " + status.set);
  } catch (error) {
    if (error.codeName !== "NotYetInitialized" && error.code !== 94) throw error;
    rs.initiate({_id:"rs0", members:[{_id:0,host:"127.0.0.1:27017"}]});
  }
'
for _ in {1..60}; do
  if "${compose[@]}" exec -T mongo mongosh --quiet --eval 'db.hello().isWritablePrimary' | grep -qx true; then
    echo 'MongoDB local ready at 127.0.0.1:27017; data volume preserved.'
    exit 0
  fi
  sleep 1
done
echo 'Replica set did not elect a primary within 60 seconds.' >&2
exit 1
