{
  "name": "enlaceseguro-sandbox",
  "version": "1.0.0",
  "description": "EnlaceSeguro Isolated Browser Sandbox Service with Playwright and Anti-SSRF Protection",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sandbox",
    "playwright",
    "security",
    "anti-ssrf",
    "fastify"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
