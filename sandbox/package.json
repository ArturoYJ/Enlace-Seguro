{
  "name": "enlaceseguro-sandbox",
  "version": "1.0.0",
  "description": "EnlaceSeguro Isolated Browser Sandbox Service with Playwright and Anti-SSRF Protection",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx 'tests/**/*.test.ts'",
    "test:browser": "node --test --test-concurrency=1 --import tsx 'browser-tests/**/*.browser.ts'",
    "test:container-hardening": "bash tests/container-hardening-smoke.sh",
    "test:egress-proxy": "bash egress-proxy/tests/integration.sh",
    "test:egress-rebinding": "bash egress-proxy/tests/dns-rebinding.sh",
    "test:dns-resolver-outage": "DNS_DROP_AFTER_A_QUERIES=2 bash egress-proxy/tests/dns-rebinding.sh",
    "test:proxy-outage": "bash egress-proxy/tests/proxy-outage.sh",
    "purge:captures": "node dist/operations/purgeCaptures.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sandbox",
    "playwright",
    "security",
    "anti-ssrf",
    "fastify"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
