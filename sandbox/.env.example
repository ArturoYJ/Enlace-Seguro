# EnlaceSeguro Sandbox Service Configuration
PORT=3001
HOST=0.0.0.0
MAX_CONCURRENCY=3
# Must stay below API SANDBOX_ANALYSIS_TIMEOUT_MS (default 30000 ms).
SANDBOX_ANALYSIS_DEADLINE_MS=25000
# Required when NODE_ENV=production. Must point to the fail-closed outbound proxy.
# Local development and tests may omit it; production must not use direct browser egress.
# SANDBOX_EGRESS_PROXY_URL=http://egress-proxy:10000
# Must match API's SANDBOX_SERVICE_TOKEN; generate with: openssl rand -base64 32
SANDBOX_SERVICE_TOKEN=replace-me
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
